<Window x:Class="Accounting.Wpf.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Wpf"
        mc:Ignorable="d"
        Title="Надходження сировини" Height="550" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"  Margin="0,0,0,20">
            <TextBlock Text="Надходження сировини"
                   FontSize="28"
                   FontWeight="Bold"/>

            <TextBlock Text="Новий документ надходження"
                   FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Дата документа:"
                        Width="130"
                        VerticalAlignment="Center"/>
                    <DatePicker Width="250" SelectedDate="{Binding DocumentDate}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Номер документа:"
               Width="130"
               VerticalAlignment="Center"/>
                    <TextBox Width="250" Text="{Binding Number}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Постачальник:"
               Width="130"
               VerticalAlignment="Center"/>
                    <TextBox Width="250" Text="{Binding SupplierName}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Склад:"
               Width="130"
               VerticalAlignment="Center"/>
                    <TextBox Width="250" Text="{Binding WarehouseName}"/>
                </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Коментар:"
               Width="130"
               VerticalAlignment="Top"/>
                <TextBox Width="250"
             Height="70"
             TextWrapping="Wrap"
             AcceptsReturn="True" Text="{Binding Comment}"/>
            </StackPanel>


        </StackPanel>
        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Зберегти"
Width="100"
Height="35"
Margin="0,0,10,0"
Click="SaveButton_Click"/>

                <Button Content="Провести"
Width="100"
Height="35"
Margin="0,0,10,0"
Click="PostButton_Click"/>

                <Button Content="Закрити"
Width="100"
Height="35"
Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
