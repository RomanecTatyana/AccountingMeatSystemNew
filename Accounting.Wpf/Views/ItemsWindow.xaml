<Window x:Class="Accounting.Wpf.Views.ItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Довідник номенклатури"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <Border Grid.Row="0"
                Style="{StaticResource PageCardStyle}"
                Margin="0,0,0,15">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Довідник номенклатури"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock Text="Сировина, готова продукція, матеріали, тара та послуги"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Оновити"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadItemsCommand}"
                            Margin="0,0,10,0"/>

                    <Button Content="Додати"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddButton_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="Змінити"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Закрити"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Таблиця -->
        <Border Grid.Row="1"
                Style="{StaticResource PageCardStyle}"
                Margin="0,0,0,15">

            <DataGrid x:Name="ItemsDataGrid"
                      ItemsSource="{Binding Items}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код"
                                        Binding="{Binding Code}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Назва"
                                        Binding="{Binding Name}"
                                        Width="260"/>

                    <DataGridTextColumn Header="Повна назва"
                                        Binding="{Binding FullName}"
                                        Width="300"/>

                    <DataGridTextColumn Header="Артикул"
                                        Binding="{Binding Article}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Штрихкод"
                                        Binding="{Binding Barcode}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Од."
                                        Binding="{Binding Unit}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Група"
                                        Binding="{Binding GroupName}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Тип"
                                        Binding="{Binding ItemType}"
                                        Width="160"/>

                    <DataGridCheckBoxColumn Header="Активна"
                                            Binding="{Binding IsActive}"
                                            Width="90"/>

                    <DataGridTextColumn Header="Коментар"
                                        Binding="{Binding Comment}"
                                        Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Нижня панель статусів -->
        <Border Grid.Row="3"
                Style="{StaticResource PageCardStyle}">

            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Vertical">

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusTextStyle}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource ErrorTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>