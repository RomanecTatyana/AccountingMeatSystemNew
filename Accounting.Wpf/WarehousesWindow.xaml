<Window x:Class="Accounting.Wpf.WarehousesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Wpf"
        mc:Ignorable="d"
        Title="Довідник складів" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Довідник складів"
                   FontSize="28"
                   FontWeight="Bold" />
            </StackPanel>

        <DataGrid Grid.Row="1"
      x:Name="ItemsDataGrid"
      ItemsSource="{Binding Warehouses}"
      AutoGenerateColumns="False"
      Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Код"
                        Binding="{Binding Code}"
                        Width="80"/>

                <DataGridTextColumn Header="Назва"
                        Binding="{Binding Name}"
                        Width="*"/>

                <DataGridTextColumn Header="Тип"
                        Binding="{Binding Type}"
                        Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
               
                <Button Content="Закрити" 
                Width="100" 
                Height="35" 
                Margin="0,0,10,0"
                Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
</Window>
