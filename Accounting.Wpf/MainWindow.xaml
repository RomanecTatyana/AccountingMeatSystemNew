<Window x:Class="Accounting.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Wpf"
        mc:Ignorable="d"
        Title="Accounting Meat System" Height="600" Width="900">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="День 16. Основы XAML"
                       FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Довідники"
                       Margin="0,0,0,5"
                       FontSize="18"
                       FontWeight="Bold"/>
            <Button Content="Довідник номенклатури"
                    Margin="0,0,10,10"
                    Height="35"
                    Click="OpenItemsWindow_Click"/>
            <Button Content="Довідник контрагентів"
                    Margin="0,0,10,10"
                    Height="35"
                    Click="OpenCounterpartiesWindow_Click"/>
            <Button Content="Довідник складів"
                    Margin="0,0,10,10"
                    Height="35"
                    Click="OpenWarehousesWindow_Click"/>
            <TextBlock Text="Документи"
                       Margin="0,0,0,5"
                       FontSize="18"
                       FontWeight="Bold"/>
            <Button Content="Надходження сировини" 
                    Margin="0,0,10,10" 
                    Height="35"         
                    Click="OpenReceiptWindow_Click"/>
            <Button Content="Звіти" Margin="0,0,10,10" Height="35"/>
            <Button Content="Налаштування" Margin="0,0,10,10" Height="35"/>
            <Button Content="Перевірити API"
                    Height="35"
                    Margin="0,0,10,10"
                    Click="CheckApiButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">

            <StackPanel Grid.Row="1" Grid.Column="1">

                <TextBlock Text="Надходження сировини"
               FontSize="22"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Номер документа:"
                   Width="130"
                   VerticalAlignment="Center"/>
                    <TextBox Width="250"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Постачальник:"
                   Width="130"
                   VerticalAlignment="Center"/>
                    <TextBox Width="250"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Склад:"
                   Width="130"
                   VerticalAlignment="Center"/>
                    <TextBox Width="250"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Зберегти"
                Width="100"
                Height="35"
                Margin="0,0,10,0"/>

                    <Button Content="Провести"
                Width="100"
                Height="35"
                Margin="0,0,10,0"/>

                    <Button Content="Очистити"
                Width="100"
                Height="35"/>
                </StackPanel>

            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
